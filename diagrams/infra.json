  "flows": [
    {
      "id": "flow-pr-validation",
      "name": "1. Validacion del PR",
      "description": "El cambio viaja desde la PC hasta la base descartable del check y el resultado vuelve al Pull Request.",
      "steps": [
        {
          "id": "step-1",
          "connectorId": "abc7bcca-a83c-4087-ae11-7cd7180e7ea6",
          "direction": "REQUEST",
          "label": "Edita el procedure"
        },
        {
          "id": "step-2",
          "connectorId": "00bf9c45-eb50-4414-91b3-a4130af9f3a0",
          "direction": "REQUEST",
          "label": "git commit"
        },
        {
          "id": "step-3",
          "connectorId": "b07b929b-4c94-4d8e-8794-9c0aaf24f441",
          "direction": "REQUEST",
          "label": "git push rama feature"
        },
        {
          "id": "step-4",
          "connectorId": "0451f940-78b0-4a09-94ee-9bba8991d849",
          "direction": "REQUEST",
          "label": "Dispara pr-check.yml"
        },
        {
          "id": "step-5",
          "connectorId": "7d19fd17-58c7-46eb-ae58-3c4fdd0c32b2",
          "direction": "REQUEST",
          "label": "flyway migrate + tests",
          "durationMs": 1600
        },
        {
          "id": "step-6",
          "connectorId": "7d19fd17-58c7-46eb-ae58-3c4fdd0c32b2",
          "direction": "RESPONSE",
          "label": "Migracion OK"
        },
        {
          "id": "step-7",
          "connectorId": "0451f940-78b0-4a09-94ee-9bba8991d849",
          "direction": "RESPONSE",
          "label": "Check verde"
        },
        {
          "id": "step-8",
          "connectorId": "b07b929b-4c94-4d8e-8794-9c0aaf24f441",
          "direction": "RESPONSE",
          "label": "PR listo para merge"
        },
        {
          "id": "48a88df6-0c7a-4e91-8a0b-d957183ecd46",
          "connectorId": "00bf9c45-eb50-4414-91b3-a4130af9f3a0",
          "direction": "RESPONSE",
          "label": "Estado del PR"
        },
        {
          "id": "5d14440b-a409-4a1a-8cce-430239e9771d",
          "connectorId": "abc7bcca-a83c-4087-ae11-7cd7180e7ea6",
          "direction": "RESPONSE",
          "label": "Notifica al desarrollador"
        }
      ]
    },
    {
      "id": "flow-deploy",
      "name": "2. Deploy dev -> test -> produccion",
      "description": "Merge a main, el workflow entra a la VPC por el runner self-hosted y promueve con aprobacion.",
      "steps": [
        {
          "id": "step-9",
          "connectorId": "b2b8f625-584e-4a44-b8c2-65c4e9caac70",
          "direction": "REQUEST",
          "label": "Merge a main"
        },
        {
          "id": "step-10",
          "connectorId": "conn-cross-vpc",
          "direction": "REQUEST",
          "label": "Dispara flyway-migrate.yml"
        },
        {
          "id": "018ebd53-be9d-44bd-926b-dd29cb5b0db1",
          "connectorId": "conn-wf-runner",
          "direction": "REQUEST",
          "label": "accionar runner",
          "durationMs": 1600
        },
        {
          "id": "step-12",
          "connectorId": "conn-runner-flyway",
          "direction": "REQUEST",
          "label": "Invoca Flyway CLI"
        },
        {
          "id": "step-13",
          "connectorId": "1cc01db6-ddfe-4c40-9116-be67b216a3ea",
          "direction": "REQUEST",
          "label": "migrate dev",
          "durationMs": 1600
        },
        {
          "id": "step-14",
          "connectorId": "1cc01db6-ddfe-4c40-9116-be67b216a3ea",
          "direction": "RESPONSE",
          "label": "dev OK"
        },
        {
          "id": "step-15",
          "connectorId": "conn-reviewer-test",
          "direction": "REQUEST",
          "label": "Aprueba testing",
          "durationMs": 1800
        },
        {
          "id": "step-16",
          "connectorId": "4b96f0fc-1720-4bc6-b198-0698dd0a7503",
          "direction": "REQUEST",
          "label": "Promueve a testing",
          "durationMs": 1600
        },
        {
          "id": "step-17",
          "connectorId": "conn-reviewer-prod",
          "direction": "REQUEST",
          "label": "Aprueba produccion",
          "durationMs": 1800
        },
        {
          "id": "step-18",
          "connectorId": "conn-test-prod",
          "direction": "REQUEST",
          "label": "Promueve a produccion",
          "durationMs": 1600
        },
        {
          "id": "step-19",
          "connectorId": "conn-test-prod",
          "direction": "RESPONSE",
          "label": "Produccion OK"
        },
        {
          "id": "step-20",
          "connectorId": "4b96f0fc-1720-4bc6-b198-0698dd0a7503",
          "direction": "RESPONSE",
          "label": "Estado"
        },
        {
          "id": "step-21",
          "connectorId": "1cc01db6-ddfe-4c40-9116-be67b216a3ea",
          "direction": "RESPONSE",
          "label": "Estado"
        },
        {
          "id": "step-22",
          "connectorId": "conn-wf-runner",
          "direction": "RESPONSE",
          "label": "Estado del runner"
        },
        {
          "id": "step-23",
          "connectorId": "conn-cross-vpc",
          "direction": "RESPONSE",
          "label": "Deploy completo"
        }
      ]
    },
